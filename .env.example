# Anthropic API Key (required for Haiku vision extraction and Opus 5 reasoning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tavily API Key (required for web search verification)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Cloud Vision API Key (optional, alternative to Haiku for OCR)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp_credentials.json

# Database URL (optional, defaults to SQLite)
DATABASE_URL=postgresql://user:password@localhost/parlaytracker

# SQL Echo (set to 'true' for debug logging)
SQL_ECHO=false
