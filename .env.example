# Copy to .env for local runs. On the laptop, deploy/setup.sh writes /opt/parlaytracker/.env.
# See SPEC.md section 3 for what each one does and which phase needs it.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/parlaytracker
DISPLAY_TZ=Europe/London

# Phase 3: closing lines
ODDS_API_KEY=
ODDS_API_RESERVE=50

# Web app: Tailscale login names allowed in (comma-separated), see SPEC.md section 9.1
ALLOWED_LOGINS=
# Local development only, never on the laptop: login to assume without Tailscale
DEV_LOGIN=

# Phase 6: screenshot extraction with Qwen through OpenRouter
QWEN_API_KEY=
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_VISION_MODEL=qwen/qwen3-vl-32b-instruct

# Optional
MIN_SAMPLE=30
# Comma-separated ESPN event IDs whose raw responses the worker records
RECORD_EVENT_IDS=

# Tests only: a Postgres database the test suite may wipe
TEST_DATABASE_URL=
