# Copy to .env for local runs. On Fly.io these are set with `fly secrets set`.
# See SPEC.md section 3 for what each one does and which phase needs it.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/parlaytracker
DISPLAY_TZ=Europe/London

# Phase 3: closing lines
ODDS_API_KEY=
ODDS_API_RESERVE=50

# Phase 6: screenshot extraction (key must match the region of the base URL)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen-vl-max

# Optional
MIN_SAMPLE=30
# Comma-separated ESPN event IDs whose raw responses the worker records
RECORD_EVENT_IDS=

# Tests only: a Postgres database the test suite may wipe
TEST_DATABASE_URL=
