# /opt/parlaytracker/.env on the laptop: mode 600, owned by root, never committed.
# deploy/setup.sh creates it. See SPEC.md section 3 for each setting.
POSTGRES_PASSWORD=change-me
DISPLAY_TZ=Europe/London
# Tailscale login names allowed to use the app, comma-separated (see deploy/README.md)
ALLOWED_LOGINS=
ODDS_API_KEY=
QWEN_API_KEY=
# rclone destination for the nightly backup copy, e.g. gdrive:parlaytracker-backups
BACKUP_RCLONE_REMOTE=
